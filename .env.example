# PixelFetch - Globale Konfiguration
APP_ENV=production

# Theme-Modus für die Galerie: auto (System-Standard), light (hell), dark (dunkel)
THEME_MODE=auto

# Standard Cache-Dauer in Sekunden (3600 = 1 Stunde), falls im Account nichts definiert ist
DEFAULT_CACHE_TTL=3600

# Dokumentation und Vorschau auf index.php deaktivieren (true/false)
DISABLE_DOCS=false